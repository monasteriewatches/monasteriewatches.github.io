---
/**
 * Trackside Series icon: a flat, straight-on racing tyre in three brand
 * colours (ink, popcorn, parchment). The popcorn sidewall band breaks at the
 * top and bottom, where "Trackside" and "Series" sit in Metamorphous small caps.
 * Original artwork; not based on any tyre maker's marks or lettering.
 * Takes the same sizing props as <Logo> so it drops into the same slots.
 */
interface Props {
  width?: string;
  height?: string;
  decorative?: boolean;
  class?: string;
}
const { width, height, decorative = false, class: className } = Astro.props;
const style = [width && `width:${width}`, height && `height:${height}`].filter(Boolean).join(';');
const id = `tire-${Math.random().toString(36).slice(2, 8)}`;

// Points on a circle around (60, 60); angle in degrees, 0 = right, 90 = down.
const C = 60;
const pt = (r: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return `${(C + r * Math.cos(a)).toFixed(2)} ${(C + r * Math.sin(a)).toFixed(2)}`;
};
const BAND = 41;
// band arcs: right side and left side, leaving gaps at the top and bottom
const right = `M ${pt(BAND, -36)} A ${BAND} ${BAND} 0 0 1 ${pt(BAND, 46)}`;
const left = `M ${pt(BAND, 134)} A ${BAND} ${BAND} 0 0 1 ${pt(BAND, 216)}`;
// text paths: top runs left to right over the top; bottom runs left to right
// under the bottom (counter-clockwise) so its letters stay upright
const top = `M ${pt(37.5, 180)} A 37.5 37.5 0 0 1 ${pt(37.5, 0)}`;
const bot = `M ${pt(44.5, 180)} A 44.5 44.5 0 0 0 ${pt(44.5, 0)}`;
const spokes = [0, 72, 144, 216, 288].map((d) => [pt(9, d - 90), pt(25, d - 90)]);
---

<svg
  class:list={['logo', 'logo-tire', className]}
  viewBox="0 0 120 120"
  style={style || undefined}
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : 'Trackside Series tyre'}
  focusable="false"
>
  <defs>
    <path id={`${id}-top`} d={top} />
    <path id={`${id}-bot`} d={bot} />
  </defs>

  <!-- tyre -->
  <circle cx="60" cy="60" r="57" style="fill: var(--color-ink)" />

  <!-- sidewall band -->
  <g style="fill: none; stroke: var(--color-popcorn); stroke-width: 3.5; stroke-linecap: round">
    <path d={right} />
    <path d={left} />
  </g>

  <!-- lettering in the gaps -->
  <g
    text-anchor="middle"
    style="fill: var(--color-popcorn); font-family: var(--font-wordmark); font-variant-caps: small-caps; font-size: 11px; letter-spacing: 0.06em"
  >
    <text><textPath href={`#${id}-top`} startOffset="50%">Trackside</textPath></text>
    <text><textPath href={`#${id}-bot`} startOffset="50%">Series</textPath></text>
  </g>

  <!-- wheel: rim, five spokes, hub -->
  <g style="stroke: var(--color-parchment); fill: none; stroke-linecap: round">
    <circle cx="60" cy="60" r="27" style="stroke-width: 4" />
    {spokes.map(([a, b]) => <path d={`M ${a} L ${b}`} style="stroke-width: 4.5" />)}
  </g>
  <circle cx="60" cy="60" r="9" style="fill: var(--color-parchment)" />
</svg>
