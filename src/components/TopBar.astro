---
/**
 * Small top menu bar: the name (home) on the left, one link per branch
 * on the right: the main branches in src/data/branches.ts plus every
 * category in src/content/categories/.
 */
import Logo from './Logo.astro';
import { getWebBranches } from '../data/catalog';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(/\/?$/, '/');
const branches = await getWebBranches();
---

<header class="topbar" data-ground="parchment">
  <div class="wrap topbar-inner">
    <a class="topbar-home" href={`${base}/`} aria-current={here === `${base}/` ? 'page' : undefined}>
      <Logo variant="wordmark-name" width="8.5rem" />
    </a>
    <nav aria-label="Main">
      <ul class="topbar-links" role="list">
        {branches.map((b) => {
          const href = `${base}/${b.href}`;
          // On phones only the short form shows; the rest stays for screen readers
          const rest = b.short && b.title.startsWith(b.short) ? b.title.slice(b.short.length) : null;
          return (
            <li>
              <a class="topbar-link" href={href} aria-current={here === href ? 'page' : here.startsWith(href) ? 'true' : undefined}>
                {rest ? <>{b.short}<span class="topbar-rest">{rest}</span></> : b.title}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    /* drawn inside the bar so it adds no height */
    box-shadow: inset 0 calc(-1 * var(--border-width)) 0 color-mix(in srgb, var(--color-plum) 14%, transparent);
  }
  .topbar-inner {
    height: var(--bar-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .topbar-home {
    display: flex;
    align-items: center;
    min-height: var(--tap-min);
    flex: none;
  }
  nav {
    min-width: 0;
  }
  .topbar-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-5);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .topbar-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-size: var(--text-small);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--dur-base) var(--ease);
  }
  .topbar-link:focus-visible,
  .topbar-link[aria-current] {
    text-decoration-color: currentColor;
  }
  @media (hover: hover) and (pointer: fine) {
    .topbar-link:hover {
      text-decoration-color: currentColor;
    }
  }
  .topbar-rest {
    white-space: pre;
  }
  /* Phones: the logo and both full names don't fit in 390px, so the links
     show their short form. The rest is clipped, not removed, so screen
     readers still hear "Brand Identity". */
  @media (max-width: 479px) {
    .topbar-inner {
      gap: var(--space-4);
    }
    .topbar-links {
      gap: var(--space-4);
    }
    .topbar-rest {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
