---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Logo from '../components/Logo.astro';
import SiteFooter from '../components/SiteFooter.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Page not found | Monasterie Watch Company"
  description="This page doesn't exist. Head back to the Monasterie homepage."
  ground="parchment"
  noindex
>
  <TopBar />
  <main id="main" class="nf">
    <div class="wrap nf-inner">
      <Logo variant="icon" height="7rem" decorative />
      <h1>Off the racing line</h1>
      <p class="muted">This page isn't on our map. It may have moved, or the link has a typo.</p>
      <div class="nf-links">
        <a class="btn btn-primary" href={`${base}/`}>Back to the homepage</a>
        <a class="btn btn-text" href={`${base}/trackside/`}>See Lights Out</a>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .nf {
    min-height: calc(100svh - var(--bar-h));
    display: grid;
    place-items: center;
    text-align: center;
  }
  .nf-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }
  .nf-inner :global(.logo) {
    width: auto;
    margin-bottom: var(--space-4);
  }
  h1,
  p {
    margin: 0;
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-4);
  }
</style>
