---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Waitlist from '../components/Waitlist.astro';
import { STATUS } from '../data/links';
import tracks from '../data/tracks.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sorted = [...tracks].sort((a, b) => a.position - b.position);
---

<BaseLayout
  title="Trackside Series: the Lights Out circuits | Monasterie"
  description="Spin the globe and explore the thirty circuits of Lights Out, from Sakhir to Hockenheim, with lap length, laps and history for each."
>
  <TopBar />
  <main id="main">
  <section class="ts" aria-labelledby="ts-intro-title">
    <h1 class="visually-hidden">Trackside Series: Lights Out and its 30 circuits</h1>

    <!-- On tablets and phones this wrapper steps aside (display: contents) so
         the title and controls sit above the globe and the story below it. -->
    <div class="ts-intro">
      <div class="ts-intro-head">
        <img
          class="ts-intro-logo"
          src={`${base}/trackside/lights-out-logo.svg`}
          alt="Lights Out logo"
          width="512"
          height="512"
        />
        <div>
          <p class="ts-intro-eyebrow">Trackside Series · Model 01</p>
          <h2 id="ts-intro-title">Lights Out</h2>
        </div>
      </div>
      <div class="ts-copy">
      <p>Five red lights. Then nothing. Lights Out is the first watch in the Monasterie Trackside Series, built to rethink what a motorsport watch can be.</p>
      <p>Not a logo stamped on a chronograph. A watch for the fans who plan weekends around qualifying, set alarms for races on the far side of the world, and know every corner by name.</p>
      <p>Built around a second time zone, so the race on the other side of the world is one glance away.</p>
      </div>
      <div class="ts-cta">
      <p class="ts-intro-prompt">Spin the globe. Find your circuit.</p>
      <p class="ts-hint" id="ts-keys">
        Drag to turn it, or Tab to it and use the arrow keys. Enter opens a circuit.
      </p>
      <div class="ts-controls">
        <button type="button" class="btn btn-secondary btn-sm" id="ts-view" aria-controls="ts-list" aria-expanded="false">
          See all 30 as a list
        </button>
        <button type="button" class="btn btn-text btn-sm" id="ts-spin" hidden>Pause rotation</button>
      </div>
      <p class="ts-intro-soon">{STATUS}</p>
      <div class="ts-next">
        <a class="btn btn-primary btn-sm" href="#reveal">Get the reveal email</a>
        <a class="btn btn-text btn-sm" href="#details">See the details</a>
      </div>
      </div>
    </div>

    <div class="ts-stage" id="ts-stage" data-base={base}>
      <!-- A still of the globe at its opening view. The live globe (globe.gl,
           about 2 MB) only loads once the visitor moves, taps, scrolls or
           presses a key, then fades in over it. Rebuild the still with
           the steps in docs/globe-poster.md if the dots or the opening view change. -->
      <img
        class="ts-poster"
        id="ts-poster"
        src={`${base}/trackside/globe-poster.webp`}
        srcset={`${base}/trackside/globe-poster-800.webp 800w, ${base}/trackside/globe-poster.webp 1600w`}
        sizes="(max-width: 1023px) min(75svh, 100vw), 100svh"
        fetchpriority="high"
        alt="The globe at night, with a gold dot on each of the 30 circuits"
        width="1600"
        height="1600"
        decoding="async"
      />
      <div
        class="ts-globe"
        id="ts-globe"
        role="group"
        aria-label="Globe of the 30 Lights Out circuits"
        aria-describedby="ts-keys"
        tabindex="0"
      ></div>
    </div>

    <!-- Shown instead of the globe when WebGL is not available -->
    <section class="ts-list" id="ts-list" hidden aria-labelledby="ts-list-title" tabindex="-1">
      <h2 id="ts-list-title">The 30 Lights Out circuits</h2>
      <ol role="list">
        {sorted.map((t) => (
          <li>
            <button type="button" class="ts-list-item" data-code={t.code}>
              <span class="ts-pos">{t.position}</span>
              <span class="ts-code">{t.code}</span>
              <span>{t.name}, {t.country} {t.flag}</span>
            </button>
          </li>
        ))}
      </ol>
    </section>

    <aside class="ts-panel" id="ts-panel" aria-labelledby="ts-name" hidden>
      <button type="button" class="ts-close" id="ts-close" aria-label="Close circuit details">×</button>
      <p class="ts-eyebrow"><span id="ts-code"></span><span id="ts-tag"></span></p>
      <h2 id="ts-name" tabindex="-1"></h2>
      <p class="ts-country" id="ts-country"></p>
      <!-- Track outline slot: set "outline" in src/data/tracks.json to a file in public/ (e.g. "tracks/SAK.svg") -->
      <div class="ts-outline" id="ts-outline" aria-hidden="true"></div>
      <dl class="ts-stats">
        <div><dt>Lap</dt><dd id="ts-len"></dd></div>
        <div><dt>Laps</dt><dd id="ts-laps"></dd></div>
        <div><dt>Distance</dt><dd id="ts-dist"></dd></div>
        <div><dt>Race time</dt><dd id="ts-dur"></dd></div>
      </dl>
      <p class="ts-history" id="ts-history"></p>
      <h3>Two things to know</h3>
      <ul class="ts-facts" id="ts-facts" role="list"></ul>
      <p class="ts-disc" id="ts-disc"></p>
      <div class="ts-actions">
        <button type="button" class="btn btn-primary btn-sm" id="ts-share">This is my circuit</button>
        <a class="btn btn-text btn-sm" href="#reveal" id="ts-to-list">Get the reveal email</a>
      </div>
      <p class="ts-share-msg" id="ts-share-msg" role="status" aria-live="polite"></p>
    </aside>

    <p class="ts-foot">Lights Out, Trackside Series by Monasterie. Not affiliated with Formula 1. Circuit outlines from <a href="https://github.com/bacinger/f1-circuits">f1-circuits</a> by Tomislav Bacinger (MIT).</p>
  </section>

  <section class="td" id="details" aria-labelledby="td-title">
    <div class="wrap">
      <header class="td-head">
        <h2 id="td-title">Lights Out, in detail</h2>
        <p class="td-lead">These are the planned specifications. The final numbers come with the reveal.</p>
      </header>

      <ul class="td-highlights" role="list" aria-label="Highlights">
        <li><span class="td-hl-num num">38 mm</span><span class="td-hl-label">case, sized to wear all weekend</span></li>
        <li><span class="td-hl-num num">100 m</span><span class="td-hl-label">water resistance, screw-down crown</span></li>
        <li><span class="td-hl-num">GMT</span><span class="td-hl-label">automatic, with a second time zone</span></li>
        <li><span class="td-hl-num">Sapphire</span><span class="td-hl-label">domed crystal</span></li>
      </ul>

      <div class="td-chapters">
        <article class="td-chapter" aria-labelledby="td-dial">
          <h3 id="td-dial">The dial</h3>
          <p>Tarmac grey and sandblasted, like a track surface seen up close. The hour markers are solid blocks of lume with no metal around them, so the whole marker glows after dark. Every printed line is signal yellow.</p>
          <p>There's one more window on the dial. It stays covered until the reveal.</p>
        </article>
        <article class="td-chapter" aria-labelledby="td-case">
          <h3 id="td-case">The case</h3>
          <p>Shaped after a race car's air intake. It's 38 mm across and about 48 mm from lug to lug, and we're holding it under 12.5 mm tall with a domed sapphire crystal on top. A rubber strap keeps it comfortable through a long race.</p>
        </article>
        <article class="td-chapter" aria-labelledby="td-movement">
          <h3 id="td-movement">The movement</h3>
          <p>Seiko NH34 movement.</p>
        </article>
      </div>

      <div class="td-specs-wrap">
        <h3 class="td-specs-title">Planned specifications</h3>
        <dl class="td-specs">
          <div><dt>Case diameter</dt><dd>38 mm</dd></div>
          <div><dt>Lug to lug</dt><dd>about 48 mm</dd></div>
          <div><dt>Height</dt><dd>12.5 mm or less</dd></div>
          <div><dt>Lug width</dt><dd>20 mm</dd></div>
          <div><dt>Crystal</dt><dd>Domed sapphire</dd></div>
          <div><dt>Water resistance</dt><dd>100 m, screw-down crown</dd></div>
          <div><dt>Movement</dt><dd>Automatic GMT</dd></div>
          <div><dt>Strap</dt><dd>Rubber</dd></div>
        </dl>
      </div>

      <div class="td-fit">
        <figure class="td-fit-fig">
          <svg viewBox="0 0 60 70" role="img" aria-labelledby="td-fit-cap">
            <rect class="td-strap" x="20" y="0" width="20" height="70" rx="1" />
            <rect class="td-lugs" x="19" y="11" width="22" height="48" rx="2" />
            <circle class="td-case" cx="30" cy="35" r="19" />
            <circle class="td-dial" cx="30" cy="35" r="15.5" />
            <line class="td-dim" x1="11" y1="35" x2="49" y2="35" />
          </svg>
          <figcaption id="td-fit-cap">Fig. 1: case outline, 38 mm across, 48 mm lug to lug.</figcaption>
        </figure>
        <div class="td-fit-text">
          <h3>Check the fit before the reveal</h3>
          <p>Size is the hardest thing to judge on a screen. Print the outline at actual size, cut it out and hold it on your wrist.</p>
          <a class="btn btn-secondary" href={`${base}/trackside/fit/`}>Print the outline</a>
        </div>
      </div>
    </div>
  </section>

  <section class="tr" id="reveal" aria-labelledby="tr-title">
    <div class="wrap tr-inner">
      <h2 id="tr-title">Be there when the covers come off</h2>
      <p class="tr-lead">One email when Lights Out is revealed. Nothing else.</p>
      <Waitlist id="trackside-list" source="trackside" label="Your email" />
    </div>
  </section>
  </main>
  <SiteFooter noForm />
</BaseLayout>

<script>
  import tracks from '../data/tracks.json';

  type Track = (typeof tracks)[number];
  const $ = (id: string) => document.getElementById(id)!;
  const stage = $('ts-stage');
  const globeEl = $('ts-globe');
  const list = $('ts-list');
  const viewBtn = $('ts-view') as HTMLButtonElement;
  const spinBtn = $('ts-spin') as HTMLButtonElement;
  const base = stage.dataset.base ?? '';
  const panel = $('ts-panel');
  const byCode = new Map(tracks.map((t) => [t.code, t]));
  const ordered = [...tracks].sort((a, b) => a.position - b.position);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const km = (n: number) => `${n.toLocaleString('en-US', { maximumFractionDigits: 3 })} km`;

  let globe: any = null;
  let started = false;
  let resumeTimer = 0;
  let userPaused = false;
  let active: HTMLElement | null = null;
  let lastFocus: HTMLElement | null = null;
  const dots = new Map<string, HTMLButtonElement>();
  let current = ordered[0].code; // the one dot that sits in the Tab order

  /* ---- Rotation --------------------------------------------------------- */
  function setAuto(on: boolean) {
    if (!globe) return;
    const focusInGlobe = globeEl.contains(document.activeElement);
    globe.controls().autoRotate = on && !reduced && !userPaused && panel.hidden && !focusInGlobe;
  }
  function resumeLater() {
    clearTimeout(resumeTimer);
    resumeTimer = window.setTimeout(() => setAuto(true), 4000);
  }
  spinBtn.addEventListener('click', () => {
    userPaused = !userPaused;
    spinBtn.textContent = userPaused ? 'Play rotation' : 'Pause rotation';
    setAuto(true);
  });

  /* ---- Panel -------------------------------------------------------------- */
  function open(t: Track, from?: HTMLElement) {
    lastFocus = from ?? (document.activeElement as HTMLElement);
    $('ts-code').textContent = t.code;
    $('ts-tag').textContent = t.calendar === 'legend' ? 'Legend' : `${t.calendar} calendar`;
    $('ts-name').textContent = t.name;
    $('ts-country').textContent = `${t.circuit} · ${t.country} ${t.flag}`;
    $('ts-len').textContent = km(t.lengthKm);
    $('ts-laps').textContent = String(t.laps);
    $('ts-dist').textContent = km(t.distanceKm);
    $('ts-dur').textContent = t.duration;
    $('ts-history').textContent = t.history;
    $('ts-facts').replaceChildren(
      ...t.facts.map((f) => Object.assign(document.createElement('li'), { textContent: f }))
    );
    $('ts-disc').textContent = `Circuit ${t.position} of ${tracks.length}.`;
    showOutline(t);
    shown = t;
    $('ts-share-msg').textContent = '';
    history.replaceState(null, '', `#${t.code}`);
    panel.hidden = false;
    panel.scrollTop = 0;
    document.body.classList.add('ts-open');
    if (matchMedia('(max-width: 767px)').matches && !stage.hidden) {
      requestAnimationFrame(() =>
        stage.scrollIntoView({ block: 'start', behavior: reduced ? 'auto' : 'smooth' })
      );
    }

    if (globe) {
      active?.classList.remove('is-active');
      active = dots.get(t.code) ?? null;
      active?.classList.add('is-active');
      setCurrent(t.code);
      globe.ringsData(reduced ? [] : [t]);
      globe.pointOfView({ lat: t.lat, lng: t.lng, altitude: 1.5 }, reduced ? 0 : 1400);
      setAuto(false);
    }
    // the heading takes focus so screen readers announce the circuit's name
    $('ts-name').focus({ preventScroll: true });
  }

  // Inline the outline SVG so it takes the popcorn colour, then mark start/finish
  // at the first point of its path.
  const outlineCache = new Map<string, string>();
  async function showOutline(t: Track) {
    const slot = $('ts-outline');
    const empty = () => {
      slot.classList.add('is-empty');
      slot.replaceChildren(Object.assign(document.createElement('span'), { textContent: 'Outline coming soon' }));
    };
    slot.dataset.code = t.code;
    if (!t.outline) return empty();
    slot.classList.remove('is-empty');
    slot.replaceChildren();
    try {
      let text = outlineCache.get(t.code);
      if (!text) {
        const res = await fetch(`${base}/${t.outline}`);
        if (!res.ok) throw new Error();
        text = await res.text();
        outlineCache.set(t.code, text);
      }
      if (slot.dataset.code !== t.code) return; // another circuit was picked meanwhile
      slot.innerHTML = text;
      const svg = slot.querySelector('svg');
      const m = svg?.querySelector('path')?.getAttribute('d')?.match(/^M\s*([\d.-]+)[ ,]([\d.-]+)/);
      if (svg && m) {
        const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        dot.setAttribute('cx', m[1]);
        dot.setAttribute('cy', m[2]);
        dot.setAttribute('r', '4.5');
        dot.setAttribute('class', 'ts-start');
        svg.append(dot);
      }
    } catch {
      empty();
    }
  }

  function close() {
    if (location.hash.slice(1) === shown?.code) history.replaceState(null, '', location.pathname);
    shown = null;
    panel.hidden = true;
    document.body.classList.remove('ts-open');
    active?.classList.remove('is-active');
    active = null;
    globe?.ringsData([]);
    const back = lastFocus && document.contains(lastFocus) ? lastFocus : null;
    back?.focus({ preventScroll: true });
    setAuto(true);
  }

  $('ts-close').addEventListener('click', close);

  /* ---- "This is my circuit": a link straight back to it -------------------- */
  let shown: Track | null = null;
  $('ts-share').addEventListener('click', async () => {
    if (!shown) return;
    const t = shown;
    const url = `${location.origin}${location.pathname}#${t.code}`;
    const msg = $('ts-share-msg');
    const data = {
      title: `My circuit: ${t.name}`,
      text: `${t.name} is my circuit. Lights Out, by Monasterie.`,
      url,
    };
    try {
      if (navigator.share && matchMedia('(pointer: coarse)').matches) {
        await navigator.share(data);
        return;
      }
      await navigator.clipboard.writeText(url);
      msg.textContent = `Link copied. Send it to someone who thinks ${t.name} isn't the best circuit.`;
    } catch (err) {
      if ((err as DOMException)?.name === 'AbortError') return; // they closed the share sheet
      msg.textContent = `Copy this link: ${url}`;
    }
  });
  // leaving the panel for the email form closes it first
  $('ts-to-list').addEventListener('click', () => close());
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) close();
  });

  /* ---- List view: every circuit as a button (also the no-WebGL fallback) -- */
  document.querySelectorAll<HTMLButtonElement>('.ts-list-item').forEach((b) =>
    b.addEventListener('click', () => open(byCode.get(b.dataset.code!)!, b))
  );
  function showList(on: boolean) {
    stage.hidden = on;
    list.hidden = !on;
    viewBtn.setAttribute('aria-expanded', String(on));
    viewBtn.textContent = on ? 'Back to the globe' : 'See all 30 as a list';
    spinBtn.hidden = on || !globe || reduced;
    if (on) {
      globe?.controls() && (globe.controls().autoRotate = false);
    } else {
      setAuto(true);
    }
  }
  viewBtn.addEventListener('click', () => showList(list.hidden));

  function fallback() {
    stage.hidden = true;
    list.hidden = false;
    viewBtn.hidden = true;
  }

  /* ---- Keyboard: one Tab stop, arrow keys walk the disc order ------------- */
  function setCurrent(code: string) {
    dots.get(current)?.setAttribute('tabindex', '-1');
    current = code;
    dots.get(current)?.setAttribute('tabindex', '0');
  }
  function focusDot(code: string) {
    const t = byCode.get(code)!;
    setCurrent(code);
    dots.get(code)?.focus({ preventScroll: true });
    // turn the globe so the focused circuit faces the viewer
    globe?.pointOfView({ lat: t.lat, lng: t.lng }, reduced ? 0 : 600);
  }
  globeEl.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (!target.classList?.contains('ts-dot')) return;
    const i = ordered.findIndex((t) => t.code === target.dataset.code);
    const n = ordered.length;
    const to: Record<string, number> = {
      ArrowRight: (i + 1) % n,
      ArrowDown: (i + 1) % n,
      ArrowLeft: (i - 1 + n) % n,
      ArrowUp: (i - 1 + n) % n,
      Home: 0,
      End: n - 1,
    };
    if (!(e.key in to)) return;
    e.preventDefault();
    focusDot(ordered[to[e.key]].code);
  });
  globeEl.addEventListener('focusin', (e) => {
    if (e.target === globeEl) {
      // the group itself is only in the Tab order until the dots exist
      if (globe && dots.size) focusDot(current);
      else start();
      return;
    }
    clearTimeout(resumeTimer);
    setAuto(false);
  });
  globeEl.addEventListener('focusout', (e) => {
    if (!globeEl.contains(e.relatedTarget as Node)) resumeLater();
  });

  /* ---- The live globe ------------------------------------------------------- */
  function hasWebGL() {
    try {
      const c = document.createElement('canvas');
      return !!(window.WebGLRenderingContext && (c.getContext('webgl2') || c.getContext('webgl')));
    } catch {
      return false;
    }
  }

  async function start() {
    if (started) return;
    started = true;
    stopListening();
    let Globe;
    try {
      Globe = (await import('globe.gl')).default;
    } catch {
      return fallback();
    }
    const token = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    // popcorn as "r,g,b" for the ring fade (three.js reads rgba, not color-mix)
    const popcorn = (token('--color-popcorn').match(/[0-9a-f]{2}/gi) ?? ['ff', 'ff', 'ff'])
      .slice(0, 3)
      .map((h) => parseInt(h, 16))
      .join(',');
    const size = () => [globeEl.clientWidth, globeEl.clientHeight];

    try {
      // animateIn stays off: the globe takes over from the still exactly in place
      globe = new Globe(globeEl, { animateIn: false })
        .width(size()[0])
        .height(size()[1])
        .backgroundColor('rgba(0,0,0,0)')
        .globeImageUrl(`${base}/earth-night.jpg`)
        .showAtmosphere(true)
        .atmosphereColor(token('--color-cerulean'))
        .atmosphereAltitude(0.2)
        .htmlElementsData(ordered)
        .htmlLat('lat')
        .htmlLng('lng')
        .htmlAltitude(0.005)
        .htmlElement((d: Track) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'ts-dot';
          b.dataset.code = d.code;
          b.tabIndex = d.code === current ? 0 : -1;
          b.setAttribute('aria-label', `${d.name}, ${d.country}, circuit ${d.position} of ${tracks.length}`);
          b.innerHTML = `<span class="ts-dot-core"></span><span class="ts-dot-label" aria-hidden="true">${d.name}</span>`;
          b.addEventListener('click', (e) => {
            e.stopPropagation();
            setCurrent(d.code);
            open(d, b);
          });
          dots.set(d.code, b);
          return b;
        })
        .ringsData([])
        .ringColor(() => (t: number) => `rgba(${popcorn},${(1 - t).toFixed(2)})`)
        .ringMaxRadius(4)
        .ringPropagationSpeed(3)
        .ringRepeatPeriod(900)
        .onGlobeReady(() => {
          stage.classList.add('is-live');
          // the live globe (labelled above) takes over; the faded still steps out
          setTimeout(() => $('ts-poster').remove(), 1000);
          globeEl.removeAttribute('tabindex');
          // someone who tabbed in while it loaded lands on the first circuit
          if (document.activeElement === globeEl) focusDot(current);
          // a shared link opened a circuit before the globe was ready
          if (shown) open(shown, dots.get(shown.code));
        });
    } catch {
      globeEl.replaceChildren();
      return fallback();
    }

    // Hide dots on the far side of the globe (they stay reachable by keyboard:
    // focusing one turns the globe to it)
    globe.htmlElementVisibilityModifier?.((node: HTMLElement, visible: boolean) => {
      node.classList.toggle('is-hidden', !visible);
    });

    const controls = globe.controls();
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.rotateSpeed = 0.6;
    controls.zoomSpeed = 0.8;
    controls.minDistance = 140;
    controls.maxDistance = 600;
    controls.autoRotateSpeed = 0.35;
    spinBtn.hidden = reduced || stage.hidden;
    setAuto(true);
    controls.addEventListener('start', () => {
      clearTimeout(resumeTimer);
      controls.autoRotate = false;
    });
    controls.addEventListener('end', resumeLater);

    // the same opening view as the still
    globe.pointOfView({ lat: 30, lng: 15, altitude: 2.4 });
    new ResizeObserver(() => {
      const [w, h] = size();
      globe.width(w).height(h);
    }).observe(globeEl);
  }

  // Load the live globe on the visitor's first sign of life, not on page load:
  // it keeps the first visit fast, and the still looks the same until then.
  const INTENT = ['pointerdown', 'pointermove', 'keydown', 'touchstart', 'wheel', 'scroll'] as const;
  function stopListening() {
    INTENT.forEach((type) => removeEventListener(type, onIntent));
  }
  function onIntent() {
    start();
  }
  if (!hasWebGL()) {
    fallback();
  } else {
    INTENT.forEach((type) => addEventListener(type, onIntent, { passive: true }));
  }

  // The panel belongs to the globe: scrolling past the globe closes it.
  new IntersectionObserver(([e]) => {
    if (!e.isIntersecting && !panel.hidden) close();
  }).observe(document.querySelector('.ts')!);

  // A shared link (/trackside/#SIL) opens straight to that circuit.
  const linked = byCode.get(location.hash.slice(1).toUpperCase());
  if (linked) {
    open(linked);
    if (hasWebGL()) start();
  }
</script>

<style>
  .ts {
    /* the intro lines up with the top bar's content edge */
    --ts-left: max(var(--grid-margin), (100% - var(--grid-max)) / 2);
    --ts-w: min(28rem, 36vw);
    position: relative;
    height: calc(100svh - var(--bar-h));
    overflow: hidden;
    background: radial-gradient(
      ellipse at 60% 45%,
      color-mix(in srgb, var(--color-plum) 88%, var(--color-parchment)) 0%,
      var(--color-plum) 45%,
      color-mix(in srgb, var(--color-plum) 55%, var(--color-ink)) 100%
    );
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .ts-stage,
  .ts-globe {
    position: absolute;
    inset: 0;
  }
  .ts-stage {
    z-index: 0; /* keep the dots under the panel */
  }
  .ts-stage[hidden] {
    display: none;
  }
  .ts-globe {
    cursor: grab;
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .ts-globe:active {
    cursor: grabbing;
  }
  /* Before the live globe loads, focus on the group shows on the still */
  .ts-globe:focus-visible {
    opacity: 1;
    outline: var(--focus-width) solid var(--color-parchment);
    outline-offset: calc(-1 * var(--space-4));
  }
  /* The still: one square image as tall as the stage, centred. The live
     globe's camera sizes the globe by the stage height too, so the two line
     up at every width. */
  .ts-poster {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    width: auto;
    max-width: none;
    translate: -50% 0;
    pointer-events: none;
    user-select: none;
    transition: opacity 300ms ease;
  }
  .ts-stage.is-live .ts-globe {
    opacity: 1;
  }
  .ts-stage.is-live .ts-poster {
    opacity: 0;
  }

  /* ---- Dots (built in the script, so styled globally) ---------------------- */
  :global(.ts-dot) {
    position: relative;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity var(--dur-base) ease;
  }
  :global(.ts-dot.is-hidden) {
    opacity: 0;
    pointer-events: none;
  }
  :global(.ts-dot-core) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-popcorn);
    box-shadow:
      0 0 6px 2px color-mix(in srgb, var(--color-popcorn) 75%, transparent),
      0 0 16px 4px color-mix(in srgb, var(--color-popcorn) 35%, transparent);
    transition: transform var(--dur-base) var(--ease-out);
  }
  :global(.ts-dot:focus-visible) {
    opacity: 1;
  }
  :global(.ts-dot:focus-visible .ts-dot-core) {
    transform: scale(1.4);
  }
  :global(.ts-dot:active .ts-dot-core) {
    transform: scale(1.15);
    transition-duration: var(--dur-fast);
  }
  @media (hover: hover) and (pointer: fine) {
    :global(.ts-dot:hover .ts-dot-core) {
      transform: scale(1.4);
    }
    :global(.ts-dot:hover .ts-dot-label) {
      opacity: 1;
    }
  }
  :global(.ts-dot.is-active .ts-dot-core) {
    animation: ts-pulse 1.2s ease-in-out infinite;
  }
  @keyframes ts-pulse {
    50% {
      transform: scale(1.8);
      box-shadow:
        0 0 10px 4px color-mix(in srgb, var(--color-popcorn) 90%, transparent),
        0 0 28px 8px color-mix(in srgb, var(--color-popcorn) 45%, transparent);
    }
  }
  :global(.ts-dot:focus-visible) {
    outline: var(--focus-width) solid var(--color-parchment);
    outline-offset: 0;
    border-radius: 50%;
  }
  :global(.ts-dot-label) {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 2px);
    translate: -50% 0;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius);
    background: var(--color-ink);
    color: var(--color-parchment);
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: var(--text-small);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast) ease;
  }
  :global(.ts-dot:focus-visible .ts-dot-label),
  :global(.ts-dot.is-active .ts-dot-label) {
    opacity: 1;
  }

  /* ---- Side panel / bottom sheet ------------------------------------------ */
  .ts-panel {
    position: fixed;
    top: calc(var(--bar-h) + var(--space-4));
    right: var(--space-4);
    bottom: var(--space-4);
    width: min(26rem, calc(100% - 2 * var(--space-4)));
    overflow-y: auto;
    padding: var(--space-6) var(--space-5) var(--space-5);
    background: color-mix(in srgb, var(--color-ink) 92%, transparent);
    border: var(--border-width) solid color-mix(in srgb, var(--color-cerulean) 35%, transparent);
    border-radius: var(--radius);
    backdrop-filter: blur(6px);
    animation: ts-in 220ms var(--ease-out) both;
    z-index: 2;
  }
  .ts-panel[hidden] {
    display: none;
  }
  @keyframes ts-in {
    from {
      opacity: 0;
      translate: 1.5rem 0;
    }
  }
  .ts-close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    width: var(--tap-min);
    height: var(--tap-min);
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--text);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }
  .ts-close {
    transition:
      background-color var(--dur-fast) ease,
      transform var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .ts-close:hover {
      background: color-mix(in srgb, var(--color-parchment) 10%, transparent);
    }
  }
  .ts-close:active {
    transform: scale(0.94);
  }
  .ts-panel h2:focus {
    outline: none;
  }
  .ts-panel h2:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--space-1);
  }
  .ts-close:focus-visible {
    outline: var(--focus-width) solid var(--focus);
  }
  .ts-eyebrow {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    margin: 0 0 var(--space-2);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  /* popcorn is the beacon's light only, never text (tokens.css) */
  #ts-code {
    font-family: var(--font-wordmark);
    font-size: 1.125rem;
    letter-spacing: var(--tracking-wordmark);
    color: var(--text);
  }
  .ts-panel h2 {
    font-size: var(--text-h2);
    margin: 0;
  }
  .ts-country {
    margin: var(--space-1) 0 var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-small);
  }
  .ts-outline {
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-4);
    border-radius: var(--radius);
    display: grid;
    place-items: center;
  }
  .ts-outline {
    color: var(--color-popcorn);
  }
  .ts-outline.is-empty {
    border: var(--border-width) dashed color-mix(in srgb, var(--color-cerulean) 30%, transparent);
    color: var(--text-muted);
    font-size: var(--text-small);
  }
  .ts-outline :global(svg) {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ts-outline :global(.ts-start) {
    fill: var(--color-parchment);
    stroke: var(--color-ink);
    stroke-width: 1.5;
  }
  .ts-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin: 0 0 var(--space-5);
  }
  .ts-stats div {
    padding: var(--space-3);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-plum) 70%, transparent);
  }
  .ts-stats dt {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .ts-stats dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: var(--text-h4);
  }
  .ts-history {
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .ts-panel h3 {
    font-size: var(--text-h4);
    margin: var(--space-5) 0 var(--space-2);
  }
  .ts-facts {
    margin: 0;
    padding-left: 1.1em;
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .ts-facts :global(li + li) {
    margin-top: var(--space-2);
  }
  .ts-disc {
    margin: var(--space-5) 0 0;
    padding-top: var(--space-4);
    border-top: var(--border-width) solid color-mix(in srgb, var(--color-cerulean) 35%, transparent);
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--text-h4);
  }

  /* ---- Fallback list ------------------------------------------------------- */
  .ts-list {
    height: 100%;
    overflow-y: auto;
    padding: var(--space-7) var(--grid-margin) var(--space-9);
    max-width: var(--grid-max);
    margin: 0 auto;
  }
  .ts-list h2 {
    font-size: var(--text-h3);
  }
  .ts-list ol {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2 22rem;
    column-gap: var(--grid-gutter);
  }
  .ts-list-item {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    width: 100%;
    min-height: var(--tap-min);
    padding: var(--space-2);
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--text);
    font: inherit;
    font-size: var(--text-small);
    text-align: left;
    cursor: pointer;
  }
  .ts-list-item {
    transition: background-color var(--dur-fast) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .ts-list-item:hover {
      background: color-mix(in srgb, var(--color-parchment) 8%, transparent);
    }
  }
  .ts-list-item:active {
    background: color-mix(in srgb, var(--color-parchment) 14%, transparent);
  }
  .ts-list[hidden] {
    display: none;
  }
  .ts-list:focus {
    outline: none;
  }
  .ts-pos {
    width: 1.5rem;
    color: var(--text-muted);
  }
  .ts-code {
    font-family: var(--font-wordmark);
    letter-spacing: var(--tracking-wordmark);
    color: var(--text);
  }

  /* ---- Intro panel ----------------------------------------------------- */
  .ts-intro {
    position: absolute;
    z-index: 1;
    left: var(--ts-left);
    top: 50%;
    translate: 0 -50%;
    width: var(--ts-w);
    max-height: calc(100% - 2 * var(--space-6));
    overflow-y: auto;
    animation: ts-intro-in 600ms var(--ease-out) both;
  }
  @keyframes ts-intro-in {
    from {
      opacity: 0;
      translate: 0 calc(-50% + 0.75rem);
    }
  }
  .ts-intro .ts-intro-eyebrow {
    max-width: none;
    margin: 0 0 var(--space-3);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .ts-intro-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-5);
  }
  .ts-intro-logo {
    width: clamp(4.5rem, 3rem + 4vw, 6.5rem);
    height: auto;
    aspect-ratio: 1;
    border-radius: var(--radius);
  }
  .ts-intro-head h2 {
    margin: 0;
  }
  .ts-intro h2 {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 2.4rem + 1.8vw, 4rem);
    line-height: 0.95;
    white-space: nowrap;
  }
  .ts-intro p {
    font-size: var(--text-small);
    line-height: var(--leading-small);
    max-width: 34ch;
  }
  .ts-intro .ts-intro-prompt {
    margin: var(--space-5) 0 var(--space-1);
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: var(--text-h4);
    color: var(--heading);
  }
  .ts-intro .ts-hint {
    margin: 0;
    color: var(--text-muted);
  }
  .ts-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-4) 0;
  }
  .ts-controls [hidden] {
    display: none;
  }
  .ts-intro .ts-intro-soon {
    margin: var(--space-1) 0 0;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  @media (min-width: 1024px) {
    /* the globe takes the space right of the intro */
    .ts-stage,
    .ts-list {
      margin-left: 0;
      left: calc(var(--ts-left) + var(--ts-w));
    }
    .ts-foot {
      left: calc(var(--ts-left) + var(--ts-w));
    }
    /* the open panel needs the room; the credit comes back when it closes */
    :global(body.ts-open) .ts-foot {
      visibility: hidden;
    }
    .ts-list {
      position: absolute;
      inset-block: 0;
      right: 0;
    }
  }
  /* Tablets and phones: intro on top, globe below */
  @media (max-width: 1023px) {
    .ts {
      height: auto;
      overflow: visible;
      display: flex;
      flex-direction: column;
    }
    .ts-intro {
      display: contents;
    }
    .ts-intro-head,
    .ts-cta,
    .ts-copy {
      padding-inline: var(--grid-margin);
    }
    .ts-intro-head {
      order: 1;
      padding-top: var(--space-6);
      animation: fade-up 600ms var(--ease-out) both;
    }
    .ts-cta {
      order: 2;
      padding-bottom: var(--space-4);
    }
    .ts-stage {
      order: 3;
    }
    .ts-list {
      order: 4;
    }
    .ts-copy {
      order: 5;
      padding-block: var(--space-6) var(--space-2);
    }
    .ts-foot {
      order: 6;
    }
    @keyframes fade-up {
      from {
        opacity: 0;
        transform: translateY(0.75rem);
      }
    }
    .ts-intro p {
      max-width: 40rem;
    }
    .ts-cta .ts-intro-prompt {
      margin-top: 0;
    }
    .ts-stage {
      position: relative;
      inset: auto;
      height: min(75svh, 100vw);
      scroll-margin-top: var(--bar-h);
    }
    .ts-foot {
      position: static;
      padding-block: var(--space-4) var(--space-5);
    }
  }

  .ts-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-3);
    text-align: center;
    font-size: var(--text-label);
    color: var(--text-muted);
    pointer-events: none;
    padding-inline: var(--grid-margin);
  }
  .ts-foot a {
    display: inline-block;
    padding-block: 4px;
    color: inherit;
    pointer-events: auto;
  }

  /* ---- Phones: bottom sheet --------------------------------------------- */
  @media (max-width: 767px) {
    .ts-panel {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      max-height: 62svh;
      border-radius: var(--radius) var(--radius) 0 0;
      border-bottom: 0;
      animation-name: ts-up;
    }
    @keyframes ts-up {
      from {
        opacity: 0;
        translate: 0 2rem;
      }
    }
    /* the globe shrinks into the space above the sheet */
    :global(body.ts-open) .ts-stage {
      height: calc(38svh - var(--bar-h));
    }
    /* room to scroll the globe up into the space above the sheet */
    :global(body.ts-open) .ts {
      padding-bottom: 62svh;
    }
    :global(body.ts-open) .ts-foot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ts-intro,
    .ts-intro-head {
      animation: none;
    }
    .ts-panel {
      animation: none;
    }
    :global(.ts-dot.is-active .ts-dot-core) {
      animation: none;
      transform: scale(1.6);
    }
    .ts-globe,
    .ts-poster {
      transition: none;
    }
  }
  /* ---- Intro: next steps ---------------------------------------------------- */
  .ts-next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-4);
  }
  p.ts-foot {
    margin: 0;
    max-width: none;
  }
  @media (max-width: 1023px) {
    p.ts-foot {
      position: static;
    }
  }

  /* ---- Panel: the circuit leads somewhere ------------------------------------ */
  .ts-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid color-mix(in srgb, var(--color-cerulean) 30%, transparent);
  }
  .ts-share-msg {
    margin: var(--space-2) 0 0;
    min-height: 1.5em;
    font-size: var(--text-small);
    line-height: var(--leading-small);
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  /* ---- Details ------------------------------------------------------------ */
  .td,
  .tr {
    border-top: var(--border-width) solid color-mix(in srgb, var(--color-cerulean) 30%, transparent);
  }
  .td {
    padding-block: var(--space-9);
  }
  .td-head {
    max-width: 40rem;
    margin-bottom: var(--space-7);
  }
  .td-head h2,
  .tr h2 {
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  .td-lead,
  .tr-lead {
    margin: 0;
    color: var(--text-muted);
  }
  .td-highlights {
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
  }
  .td-highlights li {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }
  .td-hl-num {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: var(--text-h2);
    line-height: 1;
    color: var(--heading);
  }
  .td-hl-label {
    font-size: var(--text-small);
    line-height: var(--leading-small);
    color: var(--text-muted);
    max-width: 14rem;
  }
  .td-chapters {
    display: grid;
    gap: var(--space-7);
    margin-bottom: var(--space-8);
  }
  .td-chapter h3,
  .td-specs-title,
  .td-fit h3 {
    font-size: var(--text-h3);
    margin: 0 0 var(--space-3);
  }
  .td-chapter p {
    max-width: 38rem;
  }
  .td-chapter p:last-child {
    margin-bottom: 0;
  }
  .td-specs-wrap {
    margin-bottom: var(--space-8);
  }
  .td-specs {
    margin: 0;
    display: grid;
    border-top: var(--border-width) solid color-mix(in srgb, var(--color-cerulean) 30%, transparent);
  }
  .td-specs div {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) 2fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: var(--border-width) solid color-mix(in srgb, var(--color-cerulean) 30%, transparent);
  }
  .td-specs dt {
    color: var(--text-muted);
    font-size: var(--text-small);
  }
  .td-specs dd {
    margin: 0;
    font-size: var(--text-small);
  }
  .td-fit {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .td-fit-fig {
    margin: 0;
    justify-self: center;
    width: min(100%, 15rem);
  }
  .td-fit-fig svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .td-strap {
    fill: color-mix(in srgb, var(--color-parchment) 8%, transparent);
  }
  .td-lugs,
  .td-case,
  .td-dial {
    fill: none;
    stroke: var(--color-parchment);
    stroke-width: 0.35;
  }
  .td-case {
    fill: var(--color-plum);
  }
  .td-dial {
    stroke: var(--color-cerulean);
    stroke-dasharray: 1 1;
  }
  .td-dim {
    stroke: var(--color-cerulean);
    stroke-width: 0.25;
  }
  .td-fit-fig figcaption {
    margin-top: var(--space-3);
    text-align: center;
    font-size: var(--text-small);
    color: var(--text-muted);
  }
  .td-fit-text p {
    max-width: 30rem;
  }

  /* ---- Reveal list -------------------------------------------------------- */
  .tr {
    padding-block: var(--space-9);
    background: color-mix(in srgb, var(--color-plum) 70%, var(--color-ink));
  }
  .tr-inner {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .tr-inner > * {
    max-width: 34rem;
    width: 100%;
  }
  .tr-lead {
    margin-bottom: var(--space-2);
  }

  @media (min-width: 768px) {
    .td-highlights {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .td-chapters {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
    .td-fit {
      grid-template-columns: 15rem 1fr;
      gap: var(--space-8);
    }
  }
  @media (min-width: 1024px) {
    .td-specs-wrap {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: var(--space-6);
